{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "functions/**"
    ],
    "rewrites": [
      {
        "source": "/m/**",
        "function": {
          "functionId": "share",
          "region": "us-central1"
        }
      },
      {
        "source": "/v/**",
        "function": {
          "functionId": "share",
          "region": "us-central1"
        }
      },
      {
        "source": "/n/**",
        "function": {
          "functionId": "share",
          "region": "us-central1"
        }
      },
      {
        "source": "/l/**",
        "function": {
          "functionId": "share",
          "region": "us-central1"
        }
      },
      {
        "source": "/u/**",
        "function": {
          "functionId": "share",
          "region": "us-central1"
        }
      },
      {
        "source": "/h/**",
        "function": {
          "functionId": "share",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/data/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=1800"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ]
}
