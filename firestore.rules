rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isFriend(uid) { return signedIn() && exists(/databases/$(database)/documents/friends/$(uid)/list/$(me())); }
    // Can the signed-in person see this user's Body Count, ratings and queue? (their profile privacy setting)
    function canView(uid) {
      return signedIn() && (uid == me() || isAdmin() || (
        exists(/databases/$(database)/documents/profiles/$(uid)) && (
          get(/databases/$(database)/documents/profiles/$(uid)).data.privacy.profile == 'public'
          || (get(/databases/$(database)/documents/profiles/$(uid)).data.privacy.profile == 'friends' && isFriend(uid)))));
    }

    // Site settings: featured / hidden movies, subgenre fixes, poster toggle, announcement.
    // Send feedback (signed-in people) and Contact (anyone); only admins read or clear them.
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'msg', 'name', 'page', 'ua', 'v', 't', 'uid'])
        && request.resource.data.uid == me()
        && request.resource.data.kind in ['bug', 'idea', 'other']
        && request.resource.data.msg is string && request.resource.data.msg.size() > 0 && request.resource.data.msg.size() <= 2000
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.page is string && request.resource.data.page.size() <= 300
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 300
        && request.resource.data.v is string && request.resource.data.v.size() <= 20
        && request.resource.data.t is int;
      allow read, delete: if isAdmin();
    }
    match /contact/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'name', 'topic', 'msg', 'page', 'ua', 'v', 't'])
        && request.resource.data.email is string && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') && request.resource.data.email.size() <= 120
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.topic in ['general', 'bug', 'data', 'privacy']
        && request.resource.data.msg is string && request.resource.data.msg.size() > 0 && request.resource.data.msg.size() <= 3000
        && request.resource.data.page is string && request.resource.data.page.size() <= 300
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 300
        && request.resource.data.v is string && request.resource.data.v.size() <= 20
        && request.resource.data.t is int;
      allow read, delete: if isAdmin();
    }
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin list is managed in the Firebase console only.
    match /admins/{uid} {
      allow get: if signedIn() && uid == me();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Each person's profile, services, queue and ratings are private to them.
    match /users/{uid} {
      allow read: if signedIn() && (uid == me() || isAdmin());
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['name', 'services', 'createdAt', 'lastSeen', 'hideSeen', 'notify', 'setup', 'follows'])
        && (!('follows' in request.resource.data) || (request.resource.data.follows is list && request.resource.data.follows.size() <= 300))
        && (!('notify' in request.resource.data) || request.resource.data.notify.keys().hasOnly(['friends', 'streaming']));
      allow delete: if signedIn() && uid == me();

      match /movies/{movieId} {
        allow read: if canView(uid);
        allow write: if signedIn() && uid == me();
      }
    }

    // Public profile card: name, @handle and privacy settings. Signed-in people can look each other up.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'handle', 'privacy', 'at', 'av', 'photo'])
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() < 90000))
        && request.resource.data.privacy.profile in ['public', 'friends', 'private']
        && request.resource.data.privacy.reviews in ['public', 'friends']
        && (request.resource.data.handle == '' || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.handle)).data.uid == me());
      allow delete: if signedIn() && uid == me();
      // Admins can take down an uploaded profile photo (nothing else).
      allow update: if isAdmin() && changed().hasOnly(['av', 'photo']) && request.resource.data.av == '' && request.resource.data.photo == '';
    }
    // Unique @usernames: lowercase letters, numbers and _, 3 to 20 long.
    match /usernames/{handle} {
      allow read: if signedIn();
      allow create: if signedIn() && handle.matches('^[a-z0-9_]{3,20}$') && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Friend requests: requests/{to}/from/{from} (the inbox) and sent/{from}/to/{to} (the sender's outbox).
    match /requests/{to}/from/{from} {
      allow read: if signedIn() && (me() == to || me() == from);
      allow create: if signedIn() && me() == from && from != to && request.resource.data.keys().hasOnly(['name', 'handle', 'at']);
      allow delete: if signedIn() && (me() == to || me() == from);
    }
    match /sent/{from}/to/{to} {
      allow read: if signedIn() && (me() == to || me() == from);
      allow create: if signedIn() && me() == from && from != to;
      allow delete: if signedIn() && (me() == to || me() == from);
    }
    // Friends: both sides are written when a request is accepted; either person can end it.
    match /friends/{uid}/list/{fid} {
      allow read: if signedIn() && (me() == uid || me() == fid || isAdmin());
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['name', 'handle', 'since']) && (
        (me() == uid && exists(/databases/$(database)/documents/requests/$(uid)/from/$(fid)))
        || (me() == fid && exists(/databases/$(database)/documents/requests/$(fid)/from/$(uid))));
      allow delete: if signedIn() && (me() == uid || me() == fid);
    }

    // Written reviews: public, or friends-only, as the writer chooses in their profile.
    match /reviews/{movieId}/by/{uid} {
      allow read: if resource.data.vis == 'public' || (signedIn() && (uid == me() || isAdmin() || (resource.data.vis == 'friends' && isFriend(uid))));
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'handle', 'text', 'spoiler', 'vis', 'rating', 'at'])
        && request.resource.data.uid == me()
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000
        && request.resource.data.vis in ['public', 'friends'];
      allow delete: if signedIn() && (uid == me() || isAdmin());
    }

    // Reactions (a skull or "Same") on friends' activity and on reviews. One per person per thing.
    match /rx/{key}/by/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['k', 'at']) && request.resource.data.k in ['skull', 'same'];
      allow delete: if signedIn() && uid == me();
    }
    // Each person's "reactions to you" inbox. Others can only add or remove their own note.
    match /rxin/{owner}/by/{id} {
      allow read: if signedIn() && owner == me();
      allow create, update: if signedIn() && owner != me() && id.matches('^' + me() + '_.+')
        && request.resource.data.from == me()
        && request.resource.data.keys().hasOnly(['from', 'name', 'handle', 'k', 'key', 'movie', 'kind', 'at'])
        && request.resource.data.k in ['skull', 'same'];
      allow delete: if signedIn() && (owner == me() || id.matches('^' + me() + '_.+'));
    }

    // Content warnings ("Does the dog die?"): each person answers yes/no per warning. Anyone can read the answers.
    match /cw/{movieId}/by/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['v', 'at']) && request.resource.data.v is map && request.resource.data.v.size() <= 20;
      allow delete: if signedIn() && uid == me();
    }

    // Lists people make ("Best 80s slashers"): public, friends-only or private. Anyone can follow one they can see.
    function okList(d) {
      return d.keys().hasOnly(['owner', 'name', 'handle', 'title', 'desc', 'items', 'vis', 'at', 'upd'])
        && d.owner == me() && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.desc is string && d.desc.size() <= 500 && d.items is list && d.items.size() <= 300
        && d.vis in ['public', 'friends', 'private'];
    }
    match /lists/{id} {
      allow read: if resource.data.vis == 'public'
        || (signedIn() && (resource.data.owner == me() || isAdmin() || (resource.data.vis == 'friends' && isFriend(resource.data.owner))));
      allow create: if signedIn() && okList(request.resource.data);
      allow update: if signedIn() && resource.data.owner == me() && okList(request.resource.data);
      allow delete: if signedIn() && (resource.data.owner == me() || isAdmin());
      match /fans/{uid} {
        allow read: if true;
        allow create: if signedIn() && uid == me() && request.resource.data.keys().hasOnly(['at']);
        allow delete: if signedIn() && uid == me();
      }
    }

    // Fan-reported kill counts. Anyone can read; signed-in people set only their own number; admins verify.
    match /kills/{movieId} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['verified', 'by', 'at']);
      match /votes/{uid} {
        allow read: if true;
        allow create, update: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['n', 'at'])
          && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 1000;
        allow delete: if signedIn() && (uid == me() || isAdmin());
      }
    }

    // VS matchups and brackets: admins create them, everyone can see them. Signed-in people vote once per match
    // (they can change their pick), and only while that match's round is open. Totals are count queries over votes.
    match /vs/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /m/{mk}/votes/{uid} {
        allow read: if true;
        allow create, update: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['pick', 'r', 'at'])
          && request.resource.data.pick in ['a', 'b']
          && request.resource.data.r is int
          && mk.matches('^r' + string(request.resource.data.r) + 'm[0-9]+$')
          && request.time.toMillis() >= get(/databases/$(database)/documents/vs/$(id)).data.start + (request.resource.data.r - 1) * get(/databases/$(database)/documents/vs/$(id)).data.dur
          && request.time.toMillis() < get(/databases/$(database)/documents/vs/$(id)).data.start + request.resource.data.r * get(/databases/$(database)/documents/vs/$(id)).data.dur;
        allow delete: if signedIn() && (uid == me() || isAdmin());
      }
    }

    // Movie nights: shared shortlist + voting. Knowing the night's link lets a signed-in person join.
    match /nights/{nightId} {
      allow get: if signedIn();
      allow list: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.owner == me()
        && request.resource.data.members == [me()];
      allow delete: if signedIn() && resource.data.owner == me();

      allow update: if signedIn() && request.resource.data.owner == resource.data.owner && (
        // The owner can change anything except ownership.
        resource.data.owner == me()
        // Members can suggest movies, vote for themselves, and set their own display name.
        || (me() in resource.data.members
            && changed().hasOnly(['candidates', 'votes', 'memberNames'])
            && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([me()])
            && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([me()]))
        // Members can leave (deleting their account does this), taking their vote and name with them.
        || (me() in resource.data.members && resource.data.owner != me()
            && changed().hasOnly(['members', 'memberNames', 'votes'])
            && request.resource.data.members == resource.data.members.removeAll([me()])
            && !(me() in request.resource.data.votes) && !(me() in request.resource.data.memberNames))
        // Anyone signed in with the link can add themselves.
        || (!(me() in resource.data.members)
            && changed().hasOnly(['members', 'memberNames'])
            && request.resource.data.members == resource.data.members.concat([me()])
            && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([me()]))
      );
    }
  }
}
