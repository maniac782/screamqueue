rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isFriend(uid) { return signedIn() && exists(/databases/$(database)/documents/friends/$(uid)/list/$(me())); }
    // Can the signed-in person see this user's Body Count, ratings and queue? (their profile privacy setting)
    function canView(uid) {
      return signedIn() && (uid == me() || isAdmin() || (
        exists(/databases/$(database)/documents/profiles/$(uid)) && (
          get(/databases/$(database)/documents/profiles/$(uid)).data.privacy.profile == 'public'
          || (get(/databases/$(database)/documents/profiles/$(uid)).data.privacy.profile == 'friends' && isFriend(uid)))));
    }

    // Site settings: featured / hidden movies, subgenre fixes, poster toggle, announcement.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin list is managed in the Firebase console only.
    match /admins/{uid} {
      allow get: if signedIn() && uid == me();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Each person's profile, services, queue and ratings are private to them.
    match /users/{uid} {
      allow read: if signedIn() && (uid == me() || isAdmin());
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['name', 'services', 'createdAt', 'lastSeen', 'hideSeen']);
      allow delete: if signedIn() && uid == me();

      match /movies/{movieId} {
        allow read: if canView(uid);
        allow write: if signedIn() && uid == me();
      }
    }

    // Public profile card: name, @handle and privacy settings. Signed-in people can look each other up.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'handle', 'privacy', 'at', 'av', 'photo'])
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() < 90000))
        && request.resource.data.privacy.profile in ['public', 'friends', 'private']
        && request.resource.data.privacy.reviews in ['public', 'friends']
        && (request.resource.data.handle == '' || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.handle)).data.uid == me());
    }
    // Unique @usernames: lowercase letters, numbers and _, 3 to 20 long.
    match /usernames/{handle} {
      allow read: if signedIn();
      allow create: if signedIn() && handle.matches('^[a-z0-9_]{3,20}$') && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Friend requests: requests/{to}/from/{from} (the inbox) and sent/{from}/to/{to} (the sender's outbox).
    match /requests/{to}/from/{from} {
      allow read: if signedIn() && (me() == to || me() == from);
      allow create: if signedIn() && me() == from && from != to && request.resource.data.keys().hasOnly(['name', 'handle', 'at']);
      allow delete: if signedIn() && (me() == to || me() == from);
    }
    match /sent/{from}/to/{to} {
      allow read: if signedIn() && (me() == to || me() == from);
      allow create: if signedIn() && me() == from && from != to;
      allow delete: if signedIn() && (me() == to || me() == from);
    }
    // Friends: both sides are written when a request is accepted; either person can end it.
    match /friends/{uid}/list/{fid} {
      allow read: if signedIn() && (me() == uid || me() == fid);
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['name', 'handle', 'since']) && (
        (me() == uid && exists(/databases/$(database)/documents/requests/$(uid)/from/$(fid)))
        || (me() == fid && exists(/databases/$(database)/documents/requests/$(fid)/from/$(uid))));
      allow delete: if signedIn() && (me() == uid || me() == fid);
    }

    // Written reviews: public, or friends-only, as the writer chooses in their profile.
    match /reviews/{movieId}/by/{uid} {
      allow read: if resource.data.vis == 'public' || (signedIn() && (uid == me() || isAdmin() || (resource.data.vis == 'friends' && isFriend(uid))));
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'handle', 'text', 'spoiler', 'vis', 'rating', 'at'])
        && request.resource.data.uid == me()
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000
        && request.resource.data.vis in ['public', 'friends'];
      allow delete: if signedIn() && (uid == me() || isAdmin());
    }

    // Fan-reported kill counts. Anyone can read; signed-in people set only their own number; admins verify.
    match /kills/{movieId} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['verified', 'by', 'at']);
      match /votes/{uid} {
        allow read: if true;
        allow create, update: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['n', 'at'])
          && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 1000;
        allow delete: if signedIn() && (uid == me() || isAdmin());
      }
    }

    // Movie nights: shared shortlist + voting. Knowing the night's link lets a signed-in person join.
    match /nights/{nightId} {
      allow get: if signedIn();
      allow list: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.owner == me()
        && request.resource.data.members == [me()];
      allow delete: if signedIn() && resource.data.owner == me();

      allow update: if signedIn() && request.resource.data.owner == resource.data.owner && (
        // The owner can change anything except ownership.
        resource.data.owner == me()
        // Members can suggest movies, vote for themselves, and set their own display name.
        || (me() in resource.data.members
            && changed().hasOnly(['candidates', 'votes', 'memberNames'])
            && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([me()])
            && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([me()]))
        // Anyone signed in with the link can add themselves.
        || (!(me() in resource.data.members)
            && changed().hasOnly(['members', 'memberNames'])
            && request.resource.data.members == resource.data.members.concat([me()])
            && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([me()]))
      );
    }
  }
}
